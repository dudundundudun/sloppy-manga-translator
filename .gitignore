# =====================================================================
# Miko-chan Manga Studio v6.1.0 - Git Ignore Rules
# Защищает личные API-ключи, тяжелые ИИ-модели, логи и папки с мангой от загрузки в облако
# =====================================================================

# 1. Личные настройки и секретные API-ключи (СТРОГО НЕ ЗАГРУЖАТЬ!)
config.json
gui_settings.json
.env
*.key

# 2. Тяжелые веса нейросетей и локальные модели (ГБ данных)
models/
*.gguf
*.pt
*.pth
*.onnx
*.safetensors
*.bin

# 3. Сохраненная и переведенная манга, отладка, отчеты и кэш глав
Saved_Manga/
temp_debug/
logs/
.miko/
*_EN/
*_RU/
*_ROMAJI/
.translation_state.json
TRANSLATION_REPORT.txt
UX_USAGE_REPORT.txt

# 4. Служебные файлы Python и ОС Windows
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
Thumbs.db
Desktop.ini
.DS_Store
*.log
*.jsonl
*.tmp

# 5. Rust-форк (артефакты сборки Cargo, релизные архивы и встроенная БД SQLite)
/target/
/dist/
setup_sources.json
*.onnx_dl_part
*.db-wal
*.db-shm
miko_studio.db

# 6. Пользовательские и автозагружаемые шрифты
fonts/*.ttf
fonts/*.otf
fonts/*.ttc
fonts/*.part
