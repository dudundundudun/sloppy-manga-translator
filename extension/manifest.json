{
  "manifest_version": 3,
  "name": "Local Manga / Manhwa / Manhua Translator",
  "version": "6.1.0",
  "description": "Локальный и облачный AI-переводчик манги, манхвы и маньхуа v6.1.0 (YOLO26-seg/SAM 2.1 + Baberu/HayaiOCR + DeepSeek/Ollama + LaMa)",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Открыть/скрыть Manga Translator v6.1.0"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "exclude_matches": [
        "http://127.0.0.1:5000/*",
        "http://localhost:5000/*"
      ]
    }
  ],
  "commands": {
    "translate-page": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Перевести все видимые страницы манги"
    }
  }
}
