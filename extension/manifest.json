{
  "manifest_version": 3,
  "name": "Local Manga / Manhwa / Manhua Translator",
  "version": "5.3.1",
  "description": "Локальный и облачный AI-переводчик манги, манхвы и маньхуа v5.3.1 (YOLOv8m + RT-DETR-v2 + MangaOCR + DeepSeek/Ollama + LaMa)",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_title": "Открыть/скрыть Manga Translator v5.3.1"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "translate-page": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Перевести все видимые страницы манги"
    }
  }
}
